# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=devcoach
POSTGRES_PASSWORD=change-me
POSTGRES_DB=devcoach_db
# Host port for Postgres; change if 5432 is already in use
DB_HOST_PORT=5432

GEMINI_API_KEY=
# Model used for Writing Coach scoring
GEMINI_MODEL=gemini-2.5-flash
# Model used by scripts/seed_questions.py; must support 768-dimension output
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
